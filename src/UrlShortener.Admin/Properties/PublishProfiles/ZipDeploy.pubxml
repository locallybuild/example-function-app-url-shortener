<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes to an App Service's SCM site with its publishing credentials - the
  user and password from the app's publish profile.

  Run by modules/function-app-url-shortener/9-deploy.tf, which sets these in the
  environment (MSBuild reads environment variables as properties):

    DeployHost      the app's SCM host, e.g. <app>-scm.furnace.locally:5663
    DeployUserName  the publishing user, e.g. $<app>
    DeployPassword  the publishing password

  To publish by hand, set the same three and run:

    dotnet publish -c Release -p:PublishProfile=ZipDeploy
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishUrl>https://$(DeployHost)</PublishUrl>
    <UserName>$(DeployUserName)</UserName>
    <Password>$(DeployPassword)</Password>
  </PropertyGroup>
</Project>
