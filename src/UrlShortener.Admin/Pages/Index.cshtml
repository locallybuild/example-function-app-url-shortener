@page
@model IndexModel
@{
    ViewData["Title"] = "Links";
}
<div class="card">
    <h1>Add a link</h1>
    <form method="post" asp-page-handler="Add">
        <div class="row">
            <div class="grow">
                <label asp-for="TargetUrl">Target URL</label>
                <input type="url" asp-for="TargetUrl" placeholder="https://example.com/a/very/long/path" required />
            </div>
            <div>
                <label asp-for="Code">Code (optional)</label>
                <input type="text" asp-for="Code" placeholder="random if blank" />
            </div>
            <div style="flex: 0 0 auto;">
                <button type="submit">Shorten</button>
            </div>
        </div>
        @if (Model.Error is not null)
        {
            <p class="error">@Model.Error</p>
        }
        @if (Model.Notice is not null)
        {
            <p class="notice">@Model.Notice</p>
        }
    </form>
</div>

<div class="card">
    <h1>Links</h1>
    @if (Model.Links.Count == 0)
    {
        <p class="empty">No links yet. Add one above.</p>
    }
    else
    {
        <table>
            <thead>
            <tr>
                <th>Short link</th>
                <th>Target</th>
                <th style="text-align: right;">Clicks</th>
                <th>Last clicked</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var link in Model.Links)
            {
                var shortUrl = $"{Model.ShortLinkBaseUrl}/{link.Code}";
                <tr>
                    <td><a href="@shortUrl" target="_blank" rel="noopener">@shortUrl</a></td>
                    <td class="target">@link.TargetUrl</td>
                    <td class="num">@link.Clicks</td>
                    <td>@(link.LastClickedAt?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "never")</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-code="@link.Code">
                            <button type="submit" class="danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
